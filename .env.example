# This file contains all the environment variables needed by the application.
# Copy this file to .env and fill in the values for your local development.
# DO NOT COMMIT THE .ENV FILE.

# AI Providers API Keys (choose at least one)
# The app will try them in order: Gemini, Groq, Ollama.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GROQ_MODEL=llama-3.1-70b-versatile

# For local models via Ollama
EXPO_PUBLIC_OLLAMA_ENDPOINT=
EXPO_PUBLIC_OLLAMA_MODEL=mistral

# Firebase Configs
# You can get these from your Firebase project settings.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=